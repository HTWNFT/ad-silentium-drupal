<?php

/**
 * @file
 * Module hooks for the ooh_outskirts module.
 */

/**
 * Phase 95: persistent progression planning scaffold.
 *
 * Future saved operator progression may connect to these existing surfaces only
 * after an explicit persistence/schema phase:
 * - Dossier path selection -> operator_path.
 * - Dossier selectedAttributes -> operator_attribute_signals.
 * - /play read-only evolution/channel readouts -> operator_channel_stability.
 * - Account/credits utility surfaces -> operator_clearance_tier.
 *
 * Not implemented in Phase 95: no database writes, no database schema, no user
 * fields, no new localStorage keys, no unlock logic, and no gameplay effects.
 */

/**
 * Implements hook_theme().
 */

function ooh_outskirts_theme($existing, $type, $theme, $path) {
  return [
    'ooh_landing_page' => [
      'variables' => [
        'loops' => [],
        'wind_src' => '',
      ],
      'template' => 'ooh-landing-page',
    ],

    'ooh_credits_block' => [
      'variables' => [],
      'template' => 'ooh-credits-block',
    ],

    'ooh_credits_page' => [
      'variables' => [],
      'template' => 'ooh-credits-block',
    ],

    'ooh_credits_checkout_page' => [
      'variables' => [
        'selected_pack' => '60',
        'pack_label' => 'Entry',
        'pack_amount' => 60,
        'product_code' => 'credits_entry_60',
        'checkout_enabled' => FALSE,
        'invalid_pack' => FALSE,
      ],
      'template' => 'ooh-credits-checkout-page',
    ],

    'ooh_clearance_block' => [
      'variables' => [],
      'template' => 'ooh-clearance-block',
    ],

    'ooh_clearance_page' => [
      'variables' => [],
      'template' => 'ooh-clearance-page',
    ],

    'ooh_operation_alpha_page' => [
      'variables' => [],
      'template' => 'ooh-operation-alpha-page',
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function ooh_outskirts_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $home_url = \Drupal\Core\Url::fromRoute('<front>')->toString();

  $form['#prefix'] = '<div class="ooh-login-shell"><a class="ooh-login-home" href="' . $home_url . '">Home</a><div class="ooh-login-panel">';
  $form['#suffix'] = '</div></div>';
  $form['#attached']['library'][] = 'ooh_outskirts/login';
}
