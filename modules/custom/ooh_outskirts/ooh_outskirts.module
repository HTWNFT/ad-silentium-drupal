      'path' => $path . '/templates/operation_alpha',
    ],

    'ooh_operation_alpha_finale' => [
      'variables' => [],
      'template' => 'ooh-operation-alpha-finale',
      'path' => $path . '/templates/operation_alpha',
    ],
  ];
}


/**
 * Determines whether the current route is an Operation Alpha surface.
 */
function _ooh_outskirts_is_operation_alpha_route(): bool {
  $route_name = \Drupal::routeMatch()->getRouteName();

  return is_string($route_name) && str_starts_with($route_name, 'ooh_outskirts.operation_alpha');
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function ooh_outskirts_preprocess_html(array &$variables): void {
  if (!_ooh_outskirts_is_operation_alpha_route()) {
    return;
  }

  $variables['attributes']['class'][] = 'ooh-operation-alpha-shell-lockdown';
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function ooh_outskirts_preprocess_page(array &$variables): void {
  if (!_ooh_outskirts_is_operation_alpha_route()) {
    return;
  }

  foreach (['breadcrumb', 'highlighted', 'help'] as $region) {
    if (isset($variables['page'][$region])) {
      $variables['page'][$region] = [];
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function ooh_outskirts_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $home_url = \Drupal\Core\Url::fromRoute('<front>')->toString();

  $form['#prefix'] = '<div class="ooh-login-shell"><a class="ooh-login-home" href="' . $home_url . '">Home</a><div class="ooh-login-panel">';
  $form['#suffix'] = '</div></div>';
  $form['#attached']['library'][] = 'ooh_outskirts/login';
}
