    ],

    'ooh_credits_page' => [
      'variables' => [],
      'template' => 'ooh-credits-block',
    ],

    'ooh_credits_checkout_page' => [
      'variables' => [
        'selected_pack' => '60',
        'pack_label' => 'Entry',
        'pack_amount' => 60,
        'product_code' => 'credits_entry_60',
        'checkout_enabled' => FALSE,
        'invalid_pack' => FALSE,
      ],
      'template' => 'ooh-credits-checkout-page',
    ],

    'ooh_clearance_block' => [
      'variables' => [],
      'template' => 'ooh-clearance-block',
    ],

    'ooh_clearance_page' => [
      'variables' => [],
      'template' => 'ooh-clearance-page',
    ],

    'ooh_operation_alpha_page' => [
      'variables' => [
        'account_label' => 'LOGIN / ACCOUNT',
        'account_url' => '',
        'is_authenticated' => FALSE,
        'credit_balance' => 0,
        'credit_status_label' => 'CREDITS: 0',
        'credits_url' => '',
      ],
      'template' => 'ooh-operation-alpha-page',
      'path' => $path . '/templates/operation_alpha',
    ],

    'ooh_operation_alpha_credits' => [
      'variables' => [
        'account_button_label' => 'LOGIN / ACCOUNT',
        'account_button_url' => '',
      ],
      'template' => 'ooh-operation-alpha-credits',
      'path' => $path . '/templates/operation_alpha',
    ],

    'ooh_operation_alpha_level_1' => [
      'variables' => [],
      'template' => 'ooh-operation-alpha-level-1',
      'path' => $path . '/templates/operation_alpha',
    ],

    'ooh_operation_alpha_level_2' => [
      'variables' => [],
      'template' => 'ooh-operation-alpha-level-2',
      'path' => $path . '/templates/operation_alpha',
    ],

    'ooh_operation_alpha_level_3' => [
      'variables' => [],
      'template' => 'ooh-operation-alpha-level-3',
      'path' => $path . '/templates/operation_alpha',
    ],

    'ooh_operation_alpha_level_4' => [
