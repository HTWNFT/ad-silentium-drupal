<?php

/**
 * @file
 * Module hooks for the ooh_outskirts module.
 */

/**
 * Implements hook_theme().
 */

function ooh_outskirts_theme($existing, $type, $theme, $path) {
  return [
    'ooh_landing_page' => [
      'variables' => [
        'loops' => [],
      ],
      'template' => 'ooh-landing-page',
    ],

    'ooh_credits_block' => [
      'variables' => [],
      'template' => 'ooh-credits-block',
    ],

    'ooh_credits_page' => [
      'variables' => [],
      'template' => 'ooh-credits-block',
    ],

    'ooh_credits_checkout_page' => [
      'variables' => [
        'selected_pack' => '60',
      ],
      'template' => 'ooh-credits-checkout-page',
    ],

    'ooh_clearance_block' => [
      'variables' => [],
      'template' => 'ooh-clearance-block',
    ],

    'ooh_clearance_page' => [
      'variables' => [],
      'template' => 'ooh-clearance-page',
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function ooh_outskirts_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $home_url = \Drupal\Core\Url::fromRoute('<front>')->toString();

  $form['#prefix'] = '<div class="ooh-login-shell"><a class="ooh-login-home" href="' . $home_url . '">Home</a><div class="ooh-login-panel">';
  $form['#suffix'] = '</div></div>';
  $form['#attached']['library'][] = 'ooh_outskirts/login';
}
