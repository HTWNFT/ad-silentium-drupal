  ];

  $schema['ooh_outskirts_oa_stripe_event'] = [
    'description' => 'Stores processed Operation Alpha Stripe webhook event IDs for dedupe.',
    'fields' => [
      'id' => ['description' => 'Primary webhook event record ID.', 'type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'event_id' => ['description' => 'Stripe webhook event ID.', 'type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'event_type' => ['description' => 'Stripe webhook event type.', 'type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'processed' => ['description' => 'Whether the webhook event was processed successfully.', 'type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['description' => 'Unix timestamp when this webhook event was received.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['event_id' => ['event_id']],
    'indexes' => [
      'event_type' => ['event_type'],
      'processed' => ['processed'],
    ],
  ];
  return $schema;
}
/**
 * Creates the ENTER payload save table for existing installations.
 */
function ooh_outskirts_update_9301() {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('ooh_outskirts_enter_payload')) {
    return;
  }

  $module_schema = ooh_outskirts_schema();
  $schema->createTable('ooh_outskirts_enter_payload', $module_schema['ooh_outskirts_enter_payload']);
}

/**
 * Creates the mission instance table for existing installations.
 */
function ooh_outskirts_update_9302() {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('ooh_outskirts_mission_instance')) {
    return;
  }

  $module_schema = ooh_outskirts_schema();
  $schema->createTable('ooh_outskirts_mission_instance', $module_schema['ooh_outskirts_mission_instance']);
}

/**
 * Ensures ENTER payload and mission instance tables exist.
 */
function ooh_outskirts_update_9303() {
  $schema = \Drupal::database()->schema();
  $module_schema = ooh_outskirts_schema();
  $tables = [
    'ooh_outskirts_enter_payload',
    'ooh_outskirts_mission_instance',
  ];

  foreach ($tables as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $module_schema[$table]);
    }
  }
}

/**
 * Creates the account-backed Operation Alpha credit balance table.
 */
function ooh_outskirts_update_9304() {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('ooh_outskirts_oa_credit_balance')) {
    return;
  }

  $module_schema = ooh_outskirts_schema();
  $schema->createTable('ooh_outskirts_oa_credit_balance', $module_schema['ooh_outskirts_oa_credit_balance']);
}

/**
 * Creates Operation Alpha Stripe purchase and webhook dedupe tables.
 */
function ooh_outskirts_update_9305() {
  $schema = \Drupal::database()->schema();
  $module_schema = ooh_outskirts_schema();
  $tables = [
    'ooh_outskirts_oa_credit_purchase',
    'ooh_outskirts_oa_stripe_event',
  ];

  foreach ($tables as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $module_schema[$table]);
    }
  }
}
