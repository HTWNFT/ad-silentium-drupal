<?php

/**
 * @file
 * Install, update, and uninstall hooks for the ooh_outskirts module.
 */

/**
 * Implements hook_schema().
 */
function ooh_outskirts_schema() {
  $schema['ooh_outskirts_enter_payload'] = [
    'description' => 'Stores canonical ENTER payload snapshots saved by the server.',
    'fields' => [
      'id' => [
        'description' => 'Primary payload record ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uuid' => [
        'description' => 'Stable UUID for the payload record.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'Drupal user ID that saved the payload, or 0 for anonymous.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'payload_version' => [
        'description' => 'Canonical ENTER payload schema version.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'playlist_id' => [
        'description' => 'Selected playlist machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'path_id' => [
        'description' => 'Selected path machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'campaign_route_id' => [
        'description' => 'Selected campaign route machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'route_id' => [
        'description' => 'Resolved route machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'mission_route_id' => [
        'description' => 'Mission-derived route machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'mission_type' => [
        'description' => 'Selected mission type machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'mission_id' => [
        'description' => 'Selected mission machine ID.',
        'type' => 'varchar',
        'length' => 96,
        'not null' => TRUE,
      ],
      'selected_attributes' => [
        'description' => 'JSON encoded selected attribute labels.',
        'type' => 'text',
        'size' => 'normal',
        'not null' => TRUE,
      ],
      'payload_snapshot' => [
        'description' => 'JSON encoded canonical payload snapshot for audit and later hydration.',
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'Unix timestamp when this payload was saved.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'uid_created' => ['uid', 'created'],
    ],
  ];

  $schema['ooh_outskirts_mission_instance'] = [
    'description' => 'Stores inert mission instance identity and payload linkage records.',
    'fields' => [
      'id' => [
        'description' => 'Primary mission instance record ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uuid' => [
        'description' => 'Stable UUID for the mission instance record.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'enter_payload_id' => [
        'description' => 'Linked ENTER payload record ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'enter_payload_uuid' => [
        'description' => 'Linked ENTER payload UUID.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'Drupal user ID associated with the mission instance, or 0 for anonymous.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'lifecycle_state' => [
        'description' => 'Inert lifecycle placeholder label for future continuity phases.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'Unix timestamp when this mission instance was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'updated' => [
        'description' => 'Unix timestamp when this mission instance was last updated.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'enter_payload_id' => ['enter_payload_id'],
      'enter_payload_uuid' => ['enter_payload_uuid'],
      'uid' => ['uid'],
      'lifecycle_state' => ['lifecycle_state'],
    ],
  ];

  $schema['ooh_outskirts_oa_credit_balance'] = [
    'description' => 'Stores account-backed Operation Alpha credit balances.',
    'fields' => [
      'uid' => [
        'description' => 'Drupal user ID that owns this Operation Alpha credit balance.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'balance' => [
        'description' => 'Current Operation Alpha credit balance.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'description' => 'Unix timestamp when this balance row was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'updated' => [
        'description' => 'Unix timestamp when this balance row was last updated.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['uid'],
    'indexes' => [
      'balance' => ['balance'],
      'updated' => ['updated'],
    ],
  ];

  $schema['ooh_outskirts_oa_credit_purchase'] = [
    'description' => 'Stores Operation Alpha Stripe Checkout purchase records and credit grant status.',
    'fields' => [
      'id' => ['description' => 'Primary purchase record ID.', 'type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid' => ['description' => 'Drupal user ID that created the Stripe Checkout session.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'stripe_session_id' => ['description' => 'Stripe Checkout Session ID.', 'type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'stripe_payment_intent_id' => ['description' => 'Stripe PaymentIntent ID, when available.', 'type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'stripe_event_id' => ['description' => 'Stripe webhook event ID that granted credits.', 'type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'package_id' => ['description' => 'Operation Alpha credit package machine ID.', 'type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'credits' => ['description' => 'Credits to grant after confirmed payment.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'amount_cents' => ['description' => 'Expected Stripe amount in cents.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'currency' => ['description' => 'Expected Stripe currency code.', 'type' => 'varchar', 'length' => 8, 'not null' => TRUE, 'default' => 'usd'],
      'status' => ['description' => 'Current Stripe purchase status.', 'type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'credited' => ['description' => 'Whether credits have already been granted for this session.', 'type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['description' => 'Unix timestamp when this purchase was created.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'updated' => ['description' => 'Unix timestamp when this purchase was last updated.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'credited_at' => ['description' => 'Unix timestamp when credits were granted.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['stripe_session_id' => ['stripe_session_id']],
    'indexes' => [
      'uid_created' => ['uid', 'created'],
      'payment_intent' => ['stripe_payment_intent_id'],
      'event' => ['stripe_event_id'],
      'credited' => ['credited'],
