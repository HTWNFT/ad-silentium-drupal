ooh_outskirts.landingpage:
  path: '/landingpage'
  defaults:
    _controller: '\Drupal\ooh_outskirts\Controller\OohPageController::landingpage'
    _title: 'Landing Page'
  requirements:
    _permission: 'access content'

ooh_outskirts.clearance:
  path: '/clearance'
  defaults:
    _controller: '\Drupal\ooh_outskirts\Controller\OohPageController::clearance'
    _title: 'Clearance'
  requirements:
    _permission: 'access content'

ooh_outskirts.credits:
  path: '/credits'
  defaults:
    _controller: '\Drupal\ooh_outskirts\Controller\OohPageController::credits'
    _title: 'Credits'
  requirements:
    _permission: 'access content'
