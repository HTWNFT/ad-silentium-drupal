{#
/**
 * @file
 * OOH Credits Block Template
 */
#}
{{ attach_library('ooh_outskirts/credits') }}

<section class="ooh-credits-page">
  <div class="ooh-credits-shell">
    <div class="ooh-credits-eyebrow">CREDITS</div>
    <h1 class="ooh-credits-title">VIEW OPERATIONAL CREDITS</h1>
    <p class="ooh-credits-copy">
      Credits are presentation-only until server-authoritative fulfillment exists.
    </p>

    <div class="ooh-credits-status">
      <div class="ooh-status-card">
        <span class="ooh-status-label">LOCAL DISPLAY</span>
        <strong>0</strong>
      </div>
      <div class="ooh-status-card">
        <span class="ooh-status-label">ACCESS TIER</span>
        <strong>Staged Access Preview</strong>
      </div>
    </div>

    <div class="ooh-credit-pack-grid">
      <div class="ooh-credit-pack">
        <span class="ooh-pack-tag">ENTRY</span>
        <h2>60 CREDITS</h2>
        <p>Starter preview for staged mission access.</p>
        <a class="ooh-pack-button js-ooh-credit-select" href="{{ path('ooh_outskirts.credits_checkout', {}, {'query': {'pack': 60}}) }}" data-credit-package="entry" data-credits="60" data-product-code="credits_entry_60">SELECT</a>
      </div>

      <div class="ooh-credit-pack">
        <span class="ooh-pack-tag">STANDARD</span>
        <h2>180 CREDITS</h2>
        <p>Extended operational time.</p>
        <a class="ooh-pack-button js-ooh-credit-select" href="{{ path('ooh_outskirts.credits_checkout', {}, {'query': {'pack': 180}}) }}" data-credit-package="standard" data-credits="180" data-product-code="credits_standard_180">SELECT</a>
      </div>

      <div class="ooh-credit-pack">
        <span class="ooh-pack-tag">FOUNDER</span>
        <h2>480 CREDITS</h2>
        <p>Long-session staged route preview.</p>
        <a class="ooh-pack-button js-ooh-credit-select" href="{{ path('ooh_outskirts.credits_checkout', {}, {'query': {'pack': 480}}) }}" data-credit-package="founder" data-credits="480" data-product-code="credits_founder_480">SELECT</a>
      </div>
    </div>

    <div class="ooh-credits-return">
      <a class="ooh-return-link" href="{{ path('ooh_outskirts.clearance') }}">Back to Clearance</a>
    </div>
  </div>
</section>
