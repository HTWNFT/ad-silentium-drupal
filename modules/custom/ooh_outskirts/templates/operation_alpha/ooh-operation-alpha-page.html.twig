<section class="ooh-operation-alpha" data-ooh-operation-alpha>
  <div class="ooh-operation-alpha__intro" data-ooh-operation-alpha-intro role="dialog" aria-modal="true" aria-labelledby="ooh-operation-alpha-intro-title">
    <div class="ooh-operation-alpha__intro-card">
      <p class="ooh-operation-alpha__eyebrow">OPERATION ALPHA</p>
      <h1 class="ooh-operation-alpha__intro-title" id="ooh-operation-alpha-intro-title">WELCOME TO AD SILENTIUM: OPERATION ALPHA</h1>
      <div class="ooh-operation-alpha__intro-copy">
        <p>YOU ARE THE UNSEEN HAND</p>
        <p>WHEN REALITIES CROSS</p>
        <p>AND THE PRESENT COLLIDES WITH THE FUTURE</p>
        <p>FULL GAME COMING SOON</p>
      </div>
      <button class="ooh-operation-alpha__enter" type="button" data-ooh-operation-alpha-enter>ENTER</button>
    </div>
  </div>

  <div class="ooh-operation-alpha__signal-modal" data-ooh-operation-alpha-signal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ooh-operation-alpha-signal-title">
    <form class="ooh-operation-alpha__signal-card" data-ooh-operation-alpha-signal-form>
      <p class="ooh-operation-alpha__eyebrow">SIGNAL CHANNEL</p>
      <h2 class="ooh-operation-alpha__signal-title" id="ooh-operation-alpha-signal-title">Join the Operation Alpha Signal</h2>
      <p class="ooh-operation-alpha__signal-copy">Get launch notices, credit updates, and field drops.</p>
      <label class="visually-hidden" for="ooh-operation-alpha-email">Email address</label>
      <input class="ooh-operation-alpha__signal-input" id="ooh-operation-alpha-email" type="email" autocomplete="email" placeholder="email address" data-ooh-operation-alpha-email>
      <p class="ooh-operation-alpha__signal-status" data-ooh-operation-alpha-signal-status aria-live="polite"></p>
      <div class="ooh-operation-alpha__signal-actions">
        <button class="ooh-operation-alpha__signal-button" type="submit">JOIN SIGNAL</button>
        <button class="ooh-operation-alpha__signal-button ooh-operation-alpha__signal-button--ghost" type="button" data-ooh-operation-alpha-signal-dismiss>NOT NOW</button>
      </div>
    </form>
  </div>

  <div class="ooh-operation-alpha__shell" data-ooh-operation-alpha-control>
    <nav class="ooh-operation-alpha__cta-row" aria-label="Operation Alpha account and credits">
      <a class="ooh-operation-alpha__cta-link" href="{{ path('ooh_outskirts.credits') }}">CREDITS AVAILABLE: 15</a>
      <a class="ooh-operation-alpha__cta-link" href="{{ path('user.login') }}">LOGIN / ACCOUNT</a>
    </nav>
    <h2 class="ooh-operation-alpha__title">OPERATION ALPHA CONTROL</h2>
    <p class="ooh-operation-alpha__copy" data-ooh-alpha-runtime-copy>Operation Alpha runtime pending.</p>

    <section class="ooh-operation-alpha__activation" aria-label="Operation Alpha runtime activation">
      <span class="ooh-operation-alpha__activation-kicker">LINK STATUS</span>
      <p class="ooh-operation-alpha__activation-line" data-ooh-alpha-activation-status>Shell dormant. Awaiting unseen-hand confirmation.</p>
      <button class="ooh-operation-alpha__activation-button" type="button" data-ooh-alpha-activate>INITIALIZE FIELD</button>
    </section>

    <section class="ooh-operation-alpha__scenario" aria-live="polite">
      <div class="ooh-operation-alpha__scenario-head">
        <span class="ooh-operation-alpha__pressure-label">FIELD PRESSURE</span>
        <strong class="ooh-operation-alpha__pressure-value" data-ooh-alpha-pressure>STANDBY</strong>
      </div>
      <div class="ooh-operation-alpha__atmosphere" aria-live="polite">
        <span class="ooh-operation-alpha__atmosphere-label">ATMOSPHERE</span>
        <strong class="ooh-operation-alpha__atmosphere-value" data-ooh-alpha-atmosphere>STANDBY</strong>
        <span class="ooh-operation-alpha__atmosphere-meter" data-ooh-alpha-signal-pressure>SIGNAL PRESSURE 00</span>
      </div>
      <h3 class="ooh-operation-alpha__scenario-title" data-ooh-alpha-scenario-title>SCENARIO CHANNEL INITIALIZING</h3>
      <div class="ooh-operation-alpha__situation" data-ooh-alpha-situation>
        <p>Signal corridor awaiting unstable event.</p>
        <p>The unseen hand interface is standing by.</p>
      </div>
      <div class="ooh-operation-alpha__interventions" data-ooh-alpha-interventions></div>
      <p class="ooh-operation-alpha__reaction" data-ooh-alpha-reaction>Choose an intervention when the field opens.</p>
      <div class="ooh-operation-alpha__contact-frame" data-ooh-alpha-contact hidden>
        <div class="ooh-operation-alpha__contact-portrait" aria-hidden="true">
          <img class="ooh-operation-alpha__contact-image" alt="" data-ooh-alpha-contact-image>
        </div>
        <div class="ooh-operation-alpha__contact-body">
          <span class="ooh-operation-alpha__contact-kicker">UNSEEN MARK</span>
          <strong class="ooh-operation-alpha__contact-name" data-ooh-alpha-contact-name>Signal not resolved</strong>
          <span class="ooh-operation-alpha__contact-faction" data-ooh-alpha-contact-faction>Field mark pending</span>
          <span class="ooh-operation-alpha__contact-source" data-ooh-alpha-contact-source>Transmission source pending</span>
          <p class="ooh-operation-alpha__contact-status" data-ooh-alpha-contact-status>Awaiting mark emergence.</p>
          <p class="ooh-operation-alpha__contact-transmission" data-ooh-alpha-contact-transmission>The field has noticed your hand.</p>
        </div>
      </div>
      <div class="ooh-operation-alpha__mission" data-ooh-alpha-mission hidden>
        <span class="ooh-operation-alpha__mission-kicker">ACTIVE OPERATION</span>
        <strong class="ooh-operation-alpha__mission-title" data-ooh-alpha-mission-title>Mission seed pending</strong>
        <span class="ooh-operation-alpha__mission-source" data-ooh-alpha-mission-source>MISSION SOURCE: unresolved</span>
        <p class="ooh-operation-alpha__mission-brief" data-ooh-alpha-mission-brief>Awaiting operational situation.</p>
        <button class="ooh-operation-alpha__mission-cycle" type="button" data-ooh-alpha-mission-cycle>CYCLE SEED</button>
      </div>
      <div class="ooh-operation-alpha__result" data-ooh-alpha-result hidden>
        <span class="ooh-operation-alpha__result-kicker">OPERATION RESULT</span>
        <strong class="ooh-operation-alpha__result-title" data-ooh-alpha-result-title>Outcome pending</strong>
        <span class="ooh-operation-alpha__result-field" data-ooh-alpha-result-field>FIELD STATUS: unresolved</span>
        <p class="ooh-operation-alpha__result-mark" data-ooh-alpha-result-mark>MARK RESPONSE: awaiting action.</p>
      </div>
    </section>

    <section class="ooh-operation-alpha__access-panel" aria-label="Operation Alpha access status">
      <span class="ooh-operation-alpha__access-kicker">ACCESS STATUS</span>
      <p class="ooh-operation-alpha__access-line">Runtime and credit access are staged for the next shell.</p>
      <div class="ooh-operation-alpha__access-actions">
        <a class="ooh-operation-alpha__access-button" href="{{ path('ooh_outskirts.operation_alpha_nested_playlists') }}">ENTER ACTIVE RUNTIME</a>
        <a class="ooh-operation-alpha__access-button" href="{{ path('ooh_outskirts.credits') }}">CREDITS AVAILABLE: 15</a>
        <a class="ooh-operation-alpha__access-button" href="{{ path('user.login') }}">LOGIN / ACCOUNT</a>
      </div>
    </section>
  </div>
</section>
