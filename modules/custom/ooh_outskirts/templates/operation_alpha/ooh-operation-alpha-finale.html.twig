<section class="ooh-operation-alpha-level ooh-operation-alpha-level--finale" data-ooh-alpha-finale>
  <div class="ooh-operation-alpha-level__shell">
    <p class="ooh-operation-alpha-level__eyebrow">OPERATION ALPHA // FINAL DEBRIEF</p>
    <h1 class="ooh-operation-alpha-level__title">FINAL DEBRIEF</h1>
    <p class="ooh-operation-alpha-level__copy">Full consequence review for the operation the Unseen Hand shaped.</p>

    <section class="ooh-operation-alpha-level__report" aria-label="Final after action report">
      <article>
        <span>AFTER ACTION REPORT</span>
        <p data-ooh-alpha-finale-aar>Awaiting final mission state.</p>
      </article>
      <article>
        <span>BATTLE DAMAGE ASSESSMENT</span>
        <p data-ooh-alpha-finale-bda>Damage assessment pending.</p>
      </article>
      <article>
        <span>MISSION COST</span>
        <p data-ooh-alpha-finale-cost>Cost pending.</p>
      </article>
      <article>
        <span>PERSONNEL LOST</span>
        <p data-ooh-alpha-finale-personnel>Personnel report pending.</p>
      </article>
      <article>
        <span>ENEMY IMPACT</span>
        <p data-ooh-alpha-finale-enemy>Enemy impact pending.</p>
      </article>
      <article>
        <span>SIGNAL STATUS</span>
        <p data-ooh-alpha-finale-signal>Signal status pending.</p>
      </article>
    </section>

    <section class="ooh-operation-alpha-level__summary" aria-label="Mission timeline">
      <span>MISSION TIMELINE</span>
      <div data-ooh-alpha-finale-timeline>
        <p>No mission timeline recorded.</p>
      </div>
    </section>

    <section class="ooh-operation-alpha-level__summary" aria-label="Decision chain">
      <span>DECISION CHAIN</span>
      <div data-ooh-alpha-finale-chain>
        <p>No decision chain recorded.</p>
      </div>
    </section>

    <section class="ooh-operation-alpha-level__summary" aria-label="Final outcome">
      <span>FINAL OUTCOME</span>
      <strong class="ooh-operation-alpha-level__outcome" data-ooh-alpha-finale-outcome-label>NO GO</strong>
      <p data-ooh-alpha-finale-outcome>Outcome pending.</p>
    </section>
    <section class="ooh-operation-alpha-level__debrief-popup" data-ooh-alpha-finale-popup hidden aria-hidden="true">
      <div class="ooh-operation-alpha-level__debrief-card" role="dialog" aria-modal="false" aria-labelledby="ooh-alpha-final-debrief-title">
        <div class="ooh-operation-alpha-level__transmission-identity" data-ooh-alpha-finale-transmission-identity hidden>
          <img class="ooh-operation-alpha-level__transmission-portrait" alt="" data-ooh-alpha-finale-transmission-portrait hidden>
          <strong data-ooh-alpha-finale-transmission-name></strong>
          <span data-ooh-alpha-finale-transmission-faction></span>
          <span data-ooh-alpha-finale-transmission-role></span>
          <p data-ooh-alpha-finale-transmission-hook></p>
        </div>
        <span>MISSION DEBRIEF</span>
        <h2 id="ooh-alpha-final-debrief-title">Operation Alpha Outcome</h2>
        <strong class="ooh-operation-alpha-level__outcome" data-ooh-alpha-finale-popup-outcome>NO GO</strong>
        <p data-ooh-alpha-finale-popup-summary>Mission summary pending.</p>
        <p class="ooh-operation-alpha-level__account-offer">Create an account to save credits, mission history, and unlock future drops.</p>
      </div>
    </section>

    <div class="ooh-operation-alpha-level__actions">
      <a class="ooh-operation-alpha-level__button ooh-operation-alpha-level__button--primary" href="{{ path('ooh_outskirts.operation_alpha') }}" data-ooh-alpha-try-again data-ooh-alpha-credits-url="{{ path('ooh_outskirts.operation_alpha_credits') }}">TRY AGAIN</a>
    </div>
  </div>
</section>
