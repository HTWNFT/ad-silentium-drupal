<section class="ooh-operation-alpha ooh-operation-alpha--credits" data-ooh-operation-alpha-credits>
  <div class="ooh-operation-alpha__shell ooh-operation-alpha__shell--credits">
    <nav class="ooh-operation-alpha__cta-row" aria-label="Operation Alpha credits navigation">
      <a class="ooh-operation-alpha__cta-link" href="{{ path('ooh_outskirts.operation_alpha') }}">RETURN TO OPERATION ALPHA</a>
      <a class="ooh-operation-alpha__cta-link" href="{{ path('user.login') }}">LOGIN / ACCOUNT</a>
    </nav>

    <p class="ooh-operation-alpha__eyebrow">RUNTIME CREDIT STAGING</p>
    <h1 class="ooh-operation-alpha__title">OPERATION ALPHA CREDITS</h1>
    <div class="ooh-operation-alpha__copy ooh-operation-alpha__credits-copy">
      <p>Runtime credits are used for Operation Alpha access only.</p>
      <p>Full Ad Silentium pricing may differ at launch.</p>
    </div>

    <div class="ooh-operation-alpha__credit-status" aria-label="Operation Alpha credit status">
      <div class="ooh-operation-alpha__credit-status-card">
        <span class="ooh-operation-alpha__credit-status-label">CURRENT BALANCE</span>
        <strong><span data-ooh-alpha-credit-balance>1</span> CREDIT(S)</strong>
      </div>

      <div class="ooh-operation-alpha__credit-status-card">
        <span class="ooh-operation-alpha__credit-status-label">COST PER OPERATION</span>
        <strong><span data-ooh-alpha-credit-cost>1</span> CREDIT</strong>
      </div>

      <div class="ooh-operation-alpha__credit-status-card">
        <span class="ooh-operation-alpha__credit-status-label">PAYMENT STATUS</span>
        <strong>Stripe test mode</strong>
      </div>
    </div>

    <div class="ooh-operation-alpha__credit-grid" aria-label="Operation Alpha credit options">
      <article class="ooh-operation-alpha__credit-card" data-ooh-alpha-credit-card>
        <span class="ooh-operation-alpha__credit-kicker">SINGLE CREDIT</span>
        <h2 class="ooh-operation-alpha__credit-title">$1</h2>
        <strong class="ooh-operation-alpha__credit-amount">1 CREDIT</strong>
        <p class="ooh-operation-alpha__runtime-copy">Single Operation Alpha runtime credit through Stripe test Checkout.</p>
        <button class="ooh-operation-alpha__credit-select" type="button" data-ooh-alpha-credit-select data-credit-package="single credit" data-credit-price="$1" data-credit-amount="1 credit" data-credit-count="1">PURCHASE CREDITS</button>
      </article>

      <article class="ooh-operation-alpha__credit-card" data-ooh-alpha-credit-card>
        <span class="ooh-operation-alpha__credit-kicker">FIELD PACK</span>
        <h2 class="ooh-operation-alpha__credit-title">$25</h2>
        <strong class="ooh-operation-alpha__credit-amount">30 CREDITS</strong>
        <p class="ooh-operation-alpha__runtime-copy">Contained Operation Alpha runtime block through Stripe test Checkout.</p>
        <button class="ooh-operation-alpha__credit-select" type="button" data-ooh-alpha-credit-select data-credit-package="field pack" data-credit-price="$25" data-credit-amount="30 credits" data-credit-count="30">PURCHASE CREDITS</button>
      </article>

      <article class="ooh-operation-alpha__credit-card" data-ooh-alpha-credit-card>
        <span class="ooh-operation-alpha__credit-kicker">DEEP RUNTIME</span>
        <h2 class="ooh-operation-alpha__credit-title">$75</h2>
        <strong class="ooh-operation-alpha__credit-amount">100 CREDITS</strong>
        <p class="ooh-operation-alpha__runtime-copy">Longer Operation Alpha access through Stripe test Checkout.</p>
        <button class="ooh-operation-alpha__credit-select" type="button" data-ooh-alpha-credit-select data-credit-package="deep runtime" data-credit-price="$75" data-credit-amount="100 credits" data-credit-count="100">PURCHASE CREDITS</button>
      </article>
    </div>

    <p class="ooh-operation-alpha__credit-confirmation" data-ooh-alpha-credit-confirmation aria-live="polite">No credit package staged.</p>

    <div class="ooh-operation-alpha__runtime-actions">
      <a class="ooh-operation-alpha__runtime-button" href="{{ path('ooh_outskirts.operation_alpha') }}">RETURN TO OPERATION ALPHA</a>
    </div>
  </div>
</section>
