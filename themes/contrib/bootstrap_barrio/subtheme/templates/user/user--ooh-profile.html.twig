{#
/**
 * @file
 * Cinematic account dashboard presentation for user profile pages.
 */
#}
<article{{ attributes.addClass('ooh-account-card') }}>
  <a class="ooh-account-home" href="{{ ooh_profile_home_url|default('/') }}">HOME</a>

  <p class="ooh-account-eyebrow">ACCOUNT SIGNAL</p>
  <h1 class="ooh-account-title">{{ ooh_profile_display_name|default(user.label) }}</h1>

  <div class="ooh-account-grid">
    <section class="ooh-account-section">
      <h2>Operator</h2>
      <dl class="ooh-account-list">
        <div>
          <dt>Username</dt>
          <dd>{{ ooh_profile_display_name|default(user.label) }}</dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>
            {% if ooh_profile_email %}
              {{ ooh_profile_email }}
            {% else %}
              Hidden
            {% endif %}
          </dd>
        </div>
        <div>
          <dt>Member for</dt>
          <dd>{{ ooh_profile_member_for|default('New clearance holder') }}</dd>
        </div>
      </dl>
    </section>

    <section class="ooh-account-section">
      <h2>Operation Alpha</h2>
      <div class="ooh-account-actions">
        <button
          class="ooh-account-button ooh-account-button--disabled"
          type="button"
          disabled
          aria-disabled="true"
        >
          CREDITS: {{ ooh_profile_operation_alpha_balance|default(0) }}
        </button>
        <a class="ooh-account-button" href="{{ ooh_profile_operation_alpha_url }}">
          OPERATION ALPHA RETURN
        </a>
      </div>
    </section>
  </div>
</article>
